# Fill with your own credentials. Do NOT commit .env or share it.
AGENT_COMPANY_NAME=Your Registered Company Name
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_PHONE_NUMBER=
PUBLIC_BASE_URL=https://your-public-https-url.example
SARVAM_API_KEY=

DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=true
JWT_SECRET=

# Optional fallback only for ambiguous speech / unanticipated questions.
# Leave off for purely deterministic rule-based calls.
ENABLE_LLM_FALLBACK=0
OPENAI_API_KEY=
OPENAI_MODEL=

# This is NOT the HDFC Bank eligibility service.
# Keep OFF until the lender approves the assumptions and wording.
ENABLE_PERSONAL_LOAN_ESTIMATE=0
PERSONAL_LOAN_INTEREST_RATE=
PERSONAL_LOAN_FOIR_RATIO=
PERSONAL_LOAN_TENURE_MONTHS=
